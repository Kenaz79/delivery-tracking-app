PORT=4000

# Postgres connection string (e.g. from Supabase: Project Settings > Database)
DATABASE_URL=postgres://user:password@localhost:5432/delivery_tracking

# Secret used to sign JWTs — generate a random 32+ char string for production
JWT_SECRET=replace-with-a-long-random-string

# SAP Business ByDesign — OData/SOAP credentials (leave blank while using the mock adapter)
SAP_BYD_BASE_URL=
SAP_BYD_CLIENT_ID=
SAP_BYD_CLIENT_SECRET=

# Firebase Cloud Messaging server key (leave blank while notifications are stubbed)
FCM_SERVER_KEY=
